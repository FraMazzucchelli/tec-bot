# Copia in .env e compila i valori

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Cartella con i manuali tecnici (.md / .txt)
MANUALS_DIR=manuals

# Jira (ticket)
JIRA_BASE_URL=https://tuosito.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=ASS
JIRA_ISSUE_TYPE=Task

# Telegram
TELEGRAM_BOT_TOKEN=
# Stringa casuale scelta da te (A-Z, a-z, 0-9, _ e -), la stessa passata a setWebhook
TELEGRAM_WEBHOOK_SECRET=

# Twilio (voce + WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Voce delle chiamate: Polly.Bianca-Neural (donna), Polly.Adriano-Neural (uomo)
TWILIO_VOICE=Polly.Bianca-Neural

# Operatore umano: numero in formato internazionale, es. +39333...
# Inseriscilo solo sul server (Railway), non nel repo pubblico.
HUMAN_SUPPORT_NUMBER=

# Chat sul sito (modalità "info" aperta, "prova" con CALLBACK_PASSWORD se impostato)
WEB_CHAT_ENABLED=true
WEB_CHAT_MAX_PER_HOUR=300
# Informazioni commerciali usate dalla modalità "info"
INFO_FILE=info/argo.md

# URL pubblico del server, IDENTICO a quello inserito in Twilio (serve per la firma)
PUBLIC_BASE_URL=https://example.ngrok.app

# Solo per prove locali senza firma. Mai true in produzione.
SKIP_SIGNATURE_CHECK=false
