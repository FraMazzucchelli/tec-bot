# Copia in .env e compila i valori

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Cartella con i manuali tecnici (.md / .txt)
MANUALS_DIR=manuals

# Jira (ticket)
JIRA_BASE_URL=https://tuosito.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=ASS
JIRA_ISSUE_TYPE=Task

# Telegram
TELEGRAM_BOT_TOKEN=

# Twilio (voce + WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# URL pubblico del server (per i webhook)
PUBLIC_BASE_URL=https://example.ngrok.app
